<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kid Math Control Admin"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Màn hình nhập PIN (Ban đầu hiển thị) -->
    <LinearLayout
        android:id="@+id/layoutPinSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhập mã PIN Admin (Mặc định: 1234):"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/edtPin"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:gravity="center"
            android:textSize="20sp"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng nhập Admin"/>
    </LinearLayout>

    <!-- Màn hình Quản lý Bài toán (Ẩn cho tới khi nhập đúng PIN) -->
    <LinearLayout
        android:id="@+id/layoutAdminSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thêm bài toán mới:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp">

            <EditText
                android:id="@+id/edtQuestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="Phép tính (vd: 12 + 15)"
                android:inputType="text"/>

            <EditText
                android:id="@+id/edtAnswer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Đáp án (vd: 27)"
                android:inputType="numberSigned"/>

            <Button
                android:id="@+id/btnAddMath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thêm"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Danh sách bài toán hiện có:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMathList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
            
    </LinearLayout>

</LinearLayout>
